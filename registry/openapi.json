{
 "openapi": "3.0.0",
 "info": {
  "title": "Company Registry static API",
  "version": "1"
 },
 "servers": [
  {
   "url": "https://dingalinged-cpu.github.io/registry/"
  }
 ],
 "paths": {
  "/api/companies.json": {
   "get": {
    "summary": "List all companies",
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/keywords/{keyword}.json": {
   "get": {
    "operationId": "searchCompanies",
    "summary": "Companies for a keyword slug (service or service-city). sponsored:true = paid",
    "parameters": [
     {
      "name": "keyword",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "example": "roofing-minneapolis"
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/keyword-prices.json": {
   "get": {
    "operationId": "keywordPrices",
    "summary": "Auction minimums per keyword",
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/market/{service}.json": {
   "get": {
    "operationId": "keywordMarket",
    "summary": "Keyword market data for one service across all its city/state keywords: US monthly searches, local search estimates, CPC benchmarks, competition, registry competitors, agent demand, equivalent Google Ads cost, sponsored-spot starting bids and next auction dates. Every value has source + as_of; estimates labeled.",
    "parameters": [
     {
      "name": "service",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "example": "plumber"
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/market/index.json": {
   "get": {
    "operationId": "keywordMarketIndex",
    "summary": "All services with market summary, sources, methods, auction rules, city and category lists",
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/market/city/{city}.json": {
   "get": {
    "operationId": "keywordMarketCity",
    "summary": "Top keywords in a city by searches, CPC and value",
    "parameters": [
     {
      "name": "city",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "example": "minneapolis-mn"
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/terms.json": {
   "get": {
    "summary": "Keyword to company slugs",
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/api/companies/{slug}.json": {
   "get": {
    "summary": "One company",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  }
 }
}